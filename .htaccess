RewriteEngine On

# Serve API under /api
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Static assets & existing files
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA-style front routes → index
RewriteRule ^(login|register|forgot-password|teacher|manager|admin|super)(/.*)?$ index.html [L]
